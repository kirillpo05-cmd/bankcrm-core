# Copy to .env and adjust. .env is git-ignored (SPEC.md §10.4).
# Every value here is LOCAL DEVELOPMENT ONLY. Nothing in this file is a real secret,
# and nothing in this file may be reused in any deployed environment.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=client360
POSTGRES_USER=client360
POSTGRES_PASSWORD=client360_local_only
POSTGRES_PORT=5432

# --- Kafka ------------------------------------------------------------------
# Host-side bootstrap server. From inside compose the services use kafka:9092.
KAFKA_PORT=29092

# --- Object storage for attachments, over the S3 API -------------------------
# LocalStack locally; MinIO's images stopped being publicly pullable (see the
# comment in docker-compose.yml). Nothing in the application changed — it speaks
# the S3 API through the AWS SDK, so only the endpoint moved.
S3_ACCESS_KEY=client360
S3_SECRET_KEY=client360_local_only
S3_PORT=4566

# --- Field-level encryption (SPEC.md §4.7) ----------------------------------
# In production these come from the KMS/vault and never appear in a file.
# Locally they stand in for the data key and the hash pepper.
# Generate your own with:  openssl rand -base64 32
CLIENT360_CRYPTO_DEV_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktcmVwbGFjZS1tZSE=
CLIENT360_CRYPTO_DEV_PEPPER=ZGV2LW9ubHktcGVwcGVyLXJlcGxhY2UtbWUtcGxlYXNl

# --- JWT keypair (SPEC.md §9.3) ---------------------------------------------
# Every service verifies RS256 tokens with the public half; client-service signs
# them with the private half, because POST /auth/login now exists and is the only
# issuer. Generate a local keypair and paste both lines it prints here:
#
#   scripts/dev-jwt.sh keys
#   curl -s localhost:8080/api/v1/auth/login -H 'Content-Type: application/json' #        -d '{"email":"a.nowak@bank.example","password":"local-dev-only"}'
#
# Left empty on purpose: a committed key would be a real key that every clone of
# this repository shares. `docker compose --profile app up` needs both set.
CLIENT360_JWT_PUBLIC_KEY=
# client-service only. Never give this to interaction-service or audit-service —
# a service that can sign a token can grant itself any permission in the matrix.
CLIENT360_JWT_PRIVATE_KEY=
