<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.client360</groupId>
        <artifactId>client360-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>interaction-service</artifactId>
    <name>Client360 :: interaction-service</name>
    <description>Interaction Log (SPEC §6) and, from v3, Task/Reminder (§7).</description>

    <dependencies>
        <dependency>
            <groupId>com.client360</groupId>
            <artifactId>client360-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
          Attachment storage (IL-US-06). The apache-client is excluded in favour of the JDK's own
          HTTP client: this service already runs one for its calls into client-service, and pulling
          a second HTTP stack in for a handful of PUTs is weight and a second thing to patch.
        -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          A real S3 server, for the same reason the tests use a real PostgreSQL: a doubled object
          store would agree with whatever the code assumed about pre-signing and checksums.

          LocalStack rather than MinIO because MinIO's images stopped being publicly pullable —
          both docker.io/minio/minio and quay.io/minio/minio answer 401/denied, so CI could not
          fetch them and neither could a fresh clone. Chainguard publishes MinIO but only at
          :latest, and an unpinnable test dependency is a build that breaks overnight without a
          commit. LocalStack validates signatures, which adobe/s3mock does not — and a mock that
          accepts any signature would make the pre-signed-link test prove nothing.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>localstack</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          db/migrations/interaction-service is the single source of truth for this schema. It is
          packaged into the jar as classpath:db/migration, so tests and the running service apply
          exactly the files the compose Flyway container applies.
        -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>${project.basedir}/../../db/migrations/interaction-service</directory>
                <targetPath>db/migration</targetPath>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${project.basedir}/../../db/init</directory>
                <targetPath>db/init</targetPath>
            </testResource>
            <!--
              The interaction schema carries FKs into client.clients and client.users in the shared
              development database, so its tests need the client schema applied first.
            -->
            <testResource>
                <directory>${project.basedir}/../../db/migrations/client-service</directory>
                <targetPath>db/migration-client</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
